//@version=6
// Smjer pogađa EMA presjek (long prema gore, short prema dolje). Izlaz samo na SL ili TP.
// Opcionalno: signal vrijedi samo ako je volumen iznad prosjeka.
// Kad cijena ode beTrig % u plus, SL se pomiče na ulaznu cijenu (breakeven), a TP ostaje isti.
strategy("EMA Breakeven", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.1)

fastLen = input.int(9, "Brza EMA", minval = 1)
slowLen = input.int(21, "Spora EMA", minval = 2)
slPct   = input.float(3, "Početni stop-loss %", minval = 0) / 100
tpPct   = input.float(9, "Take-profit %", minval = 0) / 100
beTrig  = input.float(3, "Breakeven nakon %", minval = 0) / 100
useVol  = input.bool(false, "Filtar volumena")
volLen  = input.int(20, "Prosjek volumena (svijeće)", minval = 1)
volMult = input.float(1.5, "Volumen > prosjek ×", minval = 0)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)

// ta.* pozivi su izvan if blokova i lijenog "or", da se računaju na svakoj svijeći.
volAvg   = ta.sma(volume, volLen)
volOk    = not useVol or volume > volMult * volAvg
longSig  = ta.crossover(fast, slow) and volOk
shortSig = ta.crossunder(fast, slow) and volOk

var bool beActive = false
if strategy.position_size == 0
    beActive := false
    if longSig
        strategy.entry("Long", strategy.long)
    else if shortSig
        strategy.entry("Short", strategy.short)

entry = strategy.position_avg_price
if strategy.position_size > 0
    if beTrig > 0 and high >= entry * (1 + beTrig)
        beActive := true
    strategy.exit("Izlaz L", "Long", stop = beActive ? entry : entry * (1 - slPct), limit = entry * (1 + tpPct))
if strategy.position_size < 0
    if beTrig > 0 and low <= entry * (1 - beTrig)
        beActive := true
    strategy.exit("Izlaz S", "Short", stop = beActive ? entry : entry * (1 + slPct), limit = entry * (1 - tpPct))

plot(fast, "Brza EMA", color.teal)
plot(slow, "Spora EMA", color.orange)
plot(strategy.position_size != 0 and beActive ? entry : na, "Breakeven", color.gray, style = plot.style_linebr)
